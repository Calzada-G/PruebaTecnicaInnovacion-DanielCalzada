# Copia este archivo a backend/.env . Todo tiene default: la POC arranca sin tocar nada.

# Base SQLite. Relativa a backend/ o absoluta.
DB_PATH=ferreteria.db

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# --- Capa de IA (OPCIONAL) ---
# Sin clave, todo el sistema funciona igual: el analisis queda no disponible y
# las relaciones muestran el texto de plantilla. Nada mas depende de esto.
# Dos consumidores, ninguno en la ruta del mostrador:
#   1. POST /api/analisis  - el analisis del sistema, bajo demanda y cacheado
#   2. scripts/redactar_justificaciones.py - una tanda, fuera de la API
# Gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Elegido por cuota del tier gratuito, no por capacidad:
#   3.7 Flash (alias gemini-flash-latest):  5 RPM /  20 al dia
#   3.1 Flash Lite:                        15 RPM / 500 al dia
# Con 20 al dia no se puede ni sembrar las 151 relaciones. Ver docs/decisiones.md.
GEMINI_MODEL=gemini-3.1-flash-lite
