# Copia este archivo a backend/.env . Todo tiene default: la POC arranca sin tocar nada.

# Base SQLite. Relativa a backend/ o absoluta.
DB_PATH=ferreteria.db

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# --- Redaccion de justificaciones con LLM (OPCIONAL) ---
# Sin clave, el sistema usa el texto de plantilla y funciona igual.
# La clave solo la consume scripts/redactar_justificaciones.py, nunca la API en runtime.
# Gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alias que sigue al flash estable vigente. Fijar una version concreta caduca:
# gemini-2.0-flash ya devuelve 404.
GEMINI_MODEL=gemini-flash-latest
